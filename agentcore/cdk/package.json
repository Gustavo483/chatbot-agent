{
  "name": "agentcore-cdk-app",
  "version": "0.1.0",
  "bin": {
    "cdk": "dist/bin/cdk.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "postbuild": "node -e \"require('fs').accessSync(require('path').resolve('dist','bin','cdk.js')); console.log('Emit OK:', require('path').resolve('dist','bin','cdk.js'));\"",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "npm run build && cdk",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "aws-cdk": "2.1100.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@aws/agentcore-cdk": "^0.1.0-alpha.19",
    "aws-cdk-lib": "^2.248.0",
    "constructs": "^10.0.0"
  }
}
